# Copy this file to config.env and edit the values below.
# config.env is gitignored on purpose since it's local/machine-specific.

# --- Data paths -------------------------------------------------------------
A_DIR=./data/Clouds/A_processed
B_DIR=./data/Clouds/B_processed
A_RESIZED=./data/Clouds/A_resized
B_RESIZED=./data/Clouds/B_resized
COMBINED_DIR=./data/Clouds/combined

# --- Training paths ----------------------------------------------------------
CKPT_DIR=./checkpoints/clouds

# --- Export -------------------------------------------------------------------
PICT_OUTPUT=./models/clouds.pict

# --- Hyperparameters -----------------------------------------------------------
WHICH_DIRECTION=AtoB
MAX_EPOCHS=30
LR=0.0001
SAVE_FREQ=1000
DISPLAY_FREQ=500
